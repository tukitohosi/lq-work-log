{
  "name": "lq-jigongben",
  "productName": "L.Q记工本",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "L.Q",
  "description": "完全离线运行的本地电子记工本",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "desktop:start": "npm run build && electron-forge start",
    "desktop:package": "npm run build && npm run icon:build && electron-forge package --platform=win32 --arch=x64",
    "desktop:make:raw": "npm run build && npm run icon:build && node scripts/make-windows-installer.mjs",
    "desktop:make": "npm run desktop:make:raw && npm run release:verify && npm run test:desktop-smoke && npm run release:finalize",
    "icon:build": "node scripts/generate-app-icon.mjs",
    "release:verify": "node scripts/finalize-release.mjs --verify-only",
    "release:finalize": "node scripts/finalize-release.mjs",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:desktop-smoke": "node scripts/electron-smoke.mjs",
    "test:launcher": "node tests/launcher-probe.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "start": "node server/index.mjs",
    "test:mobile": "node scripts/mobile-layout-smoke.mjs",
    "preview:mobile": "npm run build && node scripts/mobile-preview.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "electron-squirrel-startup": "1.0.1",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/get": "3.1.0",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "electron": "43.3.0",
    "jsdom": "30.0.1",
    "playwright-core": "^1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
